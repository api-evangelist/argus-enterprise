            "method": "GET",
            "url": "https://api.argusenterprise.com/v1/properties",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "portfolioId",
                "value": "",
                "type": "query",
                "description": "Filter by portfolio identifier"
              },
              {
                "name": "propertyType",
                "value": "",
                "type": "query",
                "description": "Filter by property type"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by property status"
              }
            ]
          },
          "docs": "Retrieve a paginated list of commercial real estate properties accessible to the authenticated user, with optional filtering by portfolio, property type, and status."
