{
  "opencollection": "1.0.0",
  "info": {
    "name": "Argus Enterprise Core Authentication API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Argus Enterprise Obtain Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.argusenterprise.com/v1/auth/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Authenticate using OAuth 2.0 Client Credentials grant to obtain a bearer token for accessing Argus Enterprise APIs."
        }
      ]
    }
  ],
  "bundled": true
}