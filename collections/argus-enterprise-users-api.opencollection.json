{
  "opencollection": "1.0.0",
  "info": {
    "name": "Argus Enterprise Core Authentication Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Argus Enterprise List Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.argusenterprise.com/v1/users",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              }
            ]
          },
          "docs": "Retrieve a list of users in the Argus Enterprise instance. Requires administrator permissions."
        },
        {
          "info": {
            "name": "Argus Enterprise Get a User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.argusenterprise.com/v1/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the user"
              }
            ]
          },
          "docs": "Retrieve information about a specific user."
        }
      ]
    }
  ],
  "bundled": true
}